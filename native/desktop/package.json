{
  "name": "nodalis-desktop",
  "productName": "Nodalis",
  "version": "1.0.0",
  "description": "Nodalis - your knowledge, connected",
  "author": "Harsha Varthan E P (H24 Creationz)",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-www": "node ../shared/prepare-www.mjs www",
    "start": "npm run prepare-www && electron .",
    "build:win": "npm run prepare-www && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.h24creationz.nodalis",
    "productName": "Nodalis",
    "copyright": "Copyright (c) H24 Creationz",
    "files": ["main.js", "www/**/*", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "Nodalis-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nodalis",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Nodalis-Portable.${ext}"
    }
  }
}
